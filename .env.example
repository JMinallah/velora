# Velora environment configuration.
# Copy to .env.local for development. Every variable the app reads is listed
# here — src/lib/env.ts validates on startup and crashes with a named error
# if a required var is missing. No secret has a fallback default.

# ── Core (required) ──────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas M0 free tier works).
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
# Database name.
MONGODB_DB=velora

# ── Auth.js (required) ───────────────────────────────────────────────────────
# Session encryption secret. Generate: npx auth secret
AUTH_SECRET=
# Google OAuth credentials (Google Cloud console → APIs & Services → Credentials;
# OAuth credentials are free and do not require billing).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend API key (free tier: 100 emails/day). Enables magic-link sign-in and
# reminder emails. Without it, development writes reminder emails to
# .data/outbox (gitignored) instead of sending them, and production sends none.
AUTH_RESEND_KEY=
# Sender; the domain must be verified in Resend (onboarding@resend.dev can
# only send to the Resend account's own address).
EMAIL_FROM=Velora <reminders@yourdomain.example>
# Public base URL of the app, used for links in emails, e.g. https://velora.example
APP_URL=

# ── AI (optional; absent → app runs in manual mode, no agent features) ───────
# Gemini API key (aistudio.google.com, free tier).
GEMINI_API_KEY=
# Pinned model. Free-tier quotas are per model and per project (AI Studio →
# rate limits): gemini-3.5-flash-lite 15 req/min, 500 req/day; gemini-3.5-flash
# (counted as 3.6 Flash) only 5/min, 20/day. gemini-2.5-flash is closed to new
# API projects. Measure (npm run evals) before changing.
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Documents (Cloudflare R2; optional in development) ────────────────────────
# Without these, development stores files under .data/uploads (gitignored)
# and production refuses uploads. Cloudflare dashboard → R2 → create a
# bucket, then "Manage R2 API tokens" (Object Read & Write on that bucket).
DOCUMENT_STORE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Scheduled jobs (required in production) ──────────────────────────────────
# Bearer token the cron caller must present to GET /api/cron/reminders and
# /api/cron/maintenance.
CRON_SECRET=
# Chat messages, audit events and the reminder dispatch log are deleted after
# this many days (minimum 30).
EVENT_RETENTION_DAYS=365
